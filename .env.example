# --- S3 connection ---
# S3 settings now live in the SQLite database (app_config table), not here.
# These environment variables are OPTIONAL: on first start, if no S3 config
# exists in the database, they are used as the initial seed values. If they are
# unset, hard-coded placeholder values are seeded instead and must be replaced
# with the correct values (by editing the app_config table).
#
# S3_BUCKET=my-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional custom endpoint for non-AWS S3-compatible providers (R2, MinIO, ...):
# S3_ENDPOINT=

# --- App (bootstrap only) ---
PORT=3000
# Local SQLite file used for S3 config, object metadata + content hashes
DB_PATH=./data.sqlite
