# --- S3 connection ---
# For AWS S3, leave S3_ENDPOINT blank and set the region.
# For Cloudflare R2 / MinIO / other S3-compatible storage, set S3_ENDPOINT to the custom endpoint URL.
S3_BUCKET=my-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: custom endpoint for non-AWS S3-compatible providers (e.g. https://<account>.r2.cloudflarestorage.com)
S3_ENDPOINT=

# --- App ---
PORT=3000
# Local SQLite file used to track object metadata + content hashes
DB_PATH=./data.sqlite
